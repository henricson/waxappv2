    "Wax_RodeK70_Notes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For all snow types when the temperature sits right on zero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikille lumityypeille, kun lämpötila on tasan nollassa."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyrir allar snjógerðir þegar hitinn situr á frostmarki."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For alle snøtyper når temperaturen ligger akkurat på null."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För alla snötyper när temperaturen ligger precis på noll."
          }
        }
      }
    },
    "Wax_RodeK76_Name" : {
