    "Wax_RodeP70_Notes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Black base wax. Burn in as a foundation under hard wax."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musta pohjavoide. Poltetaan pohjaksi pitovoiteen alle."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svartur grunnáburður. Brenndur inn sem undirlag fyrir harðáburð."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svart grunnvoks. Brennes inn som underlag for festevoks."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svart grundvalla. Bränns in som underlag för hårdvalla."
          }
        }
