    "Wax_RodeK76_Notes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The widest Rode klister range — good for changing weather."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laajin Roden klisterialue — hyvä vaihtelevaan säähän."
