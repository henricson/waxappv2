    "Onboarding_Library_Subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tick the wax lines you own. Recommendations only ever use what's ticked."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse omistamasi voidesarjat. Suositukset käyttävät vain valittuja."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakaðu við áburðinn sem þú átt. Ráðleggingar nota aðeins það sem er valið."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kryss av smøringen du har. Anbefalingene bruker bare det som er krysset av."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bocka för vallan du har. Rekommendationerna använder bara det som är förbockat."
          }
        }
