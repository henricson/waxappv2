      "comment" : "Notes for the Swix wax KX65.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For genuinely wet snow. Keep it thin or it will slow you down."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aidosti märälle lumelle. Pidä ohuena, muuten se jarruttaa."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyrir verulega blautan snjó. Hafðu þunnt, annars hægir það á þér."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For skikkelig våt snø. Hold det tynt, ellers bremser det."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För riktigt våt snö. Håll det tunt, annars bromsar det."
          }
        }
      }
    },
