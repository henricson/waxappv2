    "Wax_V60_Notes" : {
      "comment" : "Notes for the Swix wax V60.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silver content helps against icing in damp, near-zero snow."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hopeapitoisuus auttaa jäätymistä vastaan kosteassa nollakelissä."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silfurinnihaldið vinnur gegn ísingu í rökum snjó við frostmark."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sølvinnholdet motvirker ising i fuktig snø rundt null."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silverinnehållet motverkar isbildning i fuktig snö kring noll."
          }
