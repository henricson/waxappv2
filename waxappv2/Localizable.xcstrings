    "WaxGuidance_WetCorn" : {
      "comment" : "Wax guidance for wet corn snow (Group 4)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klister required. K22 Universal or KX45N work well."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klisteri. Levitä lämpimänä, ohuesti ja kalanruotokuviona."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klístur. Berðu á heitt, þunnt og í fiskibeinamynstri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klister nødvendig. K22 Universal eller KX45N fungerer godt."
          }
        },
