    "Wax_V05_Notes" : {
      "comment" : "Notes for the Swix wax V05.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For very cold, dry snow. Apply thin and cork lightly to avoid an icy layer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erittäin kylmälle, kuivalle lumelle. Levitä ohuesti ja korkkaa kevyesti."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyrir mjög kaldan, þurran snjó. Berðu þunnt á og korkaðu létt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For svært kald, tørr snø. Legg tynt og kork lett for å unngå ising."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För mycket kall, torr snö. Lägg tunt och korka lätt för att undvika isbildning."
          }
        }
      }
    },
