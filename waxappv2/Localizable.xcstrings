    "Wax_RodeK40_Notes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handles tracks running through both sun and shade."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopii laduille, jotka vaihtelevat auringon ja varjon välillä."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ræður við brautir sem skiptast á sól og skugga."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takler løyper som veksler mellom sol og skygge."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klarar spår som växlar mellan sol och skugga."
