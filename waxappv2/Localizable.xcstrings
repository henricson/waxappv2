    "Onboarding_Access_WithLifetime %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try everything free for 14 days, then subscribe — or unlock GetGrip for good with a single %@ purchase."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokeile kaikkea ilmaiseksi 14 päivää ja tilaa sitten – tai avaa GetGrip pysyvästi yhdellä %@ ostolla."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prófaðu allt frítt í 14 daga og gerstu svo áskrifandi – eða opnaðu GetGrip fyrir fullt og allt með einni %@ greiðslu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv alt gratis i 14 dager, og abonner deretter – eller lås opp GetGrip for godt med ett kjøp på %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova allt gratis i 14 dagar och prenumerera sedan – eller lås upp GetGrip för gott med ett köp på %@."
          }
        }
      }
    },
    "Onboarding_Kit_Detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We've ticked the wax lines that are easiest to buy. Change anything below, or just continue."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsimme voiteet, joita on helpoin ostaa. Muuta alla tai jatka suoraan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Við höfum valið áburðinn sem auðveldast er að kaupa. Breyttu hverju sem er hér að neðan, eða haltu bara áfram."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har krysset av smøringen som er enklest tilgjengelig for kjøp. Endre det du vil under, eller bare fortsett."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har bockat för vallan som är lättast att köpa. Ändra vad du vill nedan, eller fortsätt bara."
          }
        }
      }
    },
