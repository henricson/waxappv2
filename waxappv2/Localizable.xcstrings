    "Wax_RodeK50_Notes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For freshly fallen wet snow, often a thin cover in rain."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juuri satanelle märälle lumelle, usein ohut peite sateessa."
