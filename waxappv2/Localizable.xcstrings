    "You also have a subscription that is still renewing. Cancel it in Manage Subscription to avoid paying twice." : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulla on myös tilaus, joka uusiutuu edelleen. Peru se kohdassa Hallitse tilausta, jotta et maksa kahdesti."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú ert líka með áskrift sem endurnýjast enn. Segðu henni upp í Stjórna áskrift svo þú borgir ekki tvisvar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har også et abonnement som fortsatt fornyes. Si det opp under Administrer abonnement så du ikke betaler dobbelt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har också en prenumeration som fortfarande förnyas. Avsluta den under Hantera prenumeration så att du inte betalar två gånger."
          }
        }
      }
    },
