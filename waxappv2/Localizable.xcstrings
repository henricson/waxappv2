    "Wax_PSP_Notes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extreme cold glide wax. Iron cool and brush thoroughly."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luistovoide äärimmäiseen kylmyyteen. Silitä viileänä ja harjaa huolella."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rennsliáburður fyrir mikinn kulda. Strjúktu svalt og burstaðu vel."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glidvoks for ekstrem kulde. Stryk kjølig og børst grundig."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glidvalla för extrem kyla. Stryk svalt och borsta noggrant."
          }
        }
      }
    },
