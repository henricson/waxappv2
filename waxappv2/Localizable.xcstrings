      }
    },
    "We couldn't reach a weather service. You can still set the temperature and snow type by hand below." : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sääpalveluun ei saatu yhteyttä. Voit silti asettaa lämpötilan ja lumityypin käsin alla."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Við náðum ekki í veðurþjónustu. Þú getur samt stillt hita og snjógerð handvirkt hér að neðan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi fikk ikke kontakt med en værtjeneste. Du kan fortsatt sette temperatur og snøtype manuelt nedenfor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi nådde ingen vädertjänst. Du kan ändå ställa in temperatur och snötyp manuellt nedan."
          }
        }
      }
    },
    "We read ten days of weather for your location, work out what the snow has become, and match it to the wax you own." : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luemme kymmenen päivän sään sijainnillesi, päättelemme lumen tilan ja sovitamme sen voiteisiisi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Við lesum tíu daga veður fyrir staðsetningu þína, metum hvað snjórinn er orðinn og pörum við áburðinn þinn."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi leser ti dager med vær for stedet ditt, finner ut hva snøen har blitt, og matcher den mot voksen du har."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi läser tio dagar av väder för din plats, räknar ut vad snön har blivit och matchar mot vallan du har."
          }
        }
      }
    },
