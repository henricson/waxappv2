    "Wax_RodeK90_Notes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An adhesive base for other klisters and kick waxes, not a wax of the day."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartuntapohja muille klistereille ja pitovoiteille, ei päivän voide."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Límgrunnur fyrir önnur klístur og festiáburði, ekki áburður dagsins."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et heftegrunnlag for andre klistere og festevokser, ikke dagens voks."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett vidhäftande underlag för andra klister och fästvallor, inte dagens valla."
          }
        }
      }
    },
    "Wax_RodeMultigrade_Notes" : {
      "localizations" : {
        "en" : {
