    "Wax_V50_Notes" : {
      "comment" : "Notes for the Swix wax V50.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swix publishes this one at 0 °C exactly — a narrow but very useful window."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swix ilmoittaa tämän tasan 0 °C:ssa — kapea mutta hyödyllinen ikkuna."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swix gefur hann upp við nákvæmlega 0 °C — þröngt en gagnlegt bil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swix oppgir denne på nøyaktig 0 °C — et smalt, men svært nyttig vindu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swix anger den vid exakt 0 °C — ett smalt men mycket användbart fönster."
          }
        }
      }
    },
