    "One-time purchase. Restore it on all your devices with the same Apple Account." : {
      "localizations" : {
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kertaosto. Palauta se kaikilla laitteillasi samalla Apple-tilillä."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingreiðsla. Endurheimtu hana á öllum tækjum þínum með sama Apple-reikningi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
