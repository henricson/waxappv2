    "Wax_VP70_Notes" : {
      "comment" : "Notes for the Swix wax VP70.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The softest Pro hard wax. Expect a short kick zone and frequent re-waxing."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pehmein Pro-pitovoide. Varaudu lyhyeen pitoalueeseen ja usein voiteluun."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mýksti Pro-harðáburðurinn. Bústu við stuttu festisvæði og tíðri endurbornun."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den mykeste Pro-festevoksen. Regn med kort festesone og hyppig påsmøring."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den mjukaste Pro-hårdvallan. Räkna med kort fästzon och tät omvallning."
          }
        }
      }
    },
    "WaxGuidance_FineGrained" : {
      "comment" : "Wax guidance for fine-grained snow (Group 2)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard grip wax based on temperature. Good day for all wax types."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitovoide, hieman kovempi kuin ilman lämpötila antaa olettaa."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harðáburður, örlítið harðari en lofthitinn gefur til kynna."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard festevoks etter temperatur. God dag for alle vokstyper."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hårdvalla, något hårdare än lufttemperaturen antyder."
          }
        }
      }
    },
    "WaxGuidance_FrozenCorn" : {
      "comment" : "Wax guidance for frozen corn snow (Group 5)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ice klister: KX30 Blue or KN33. Can be challenging conditions."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jääklisteri pohjavoiteen päälle. Anna jokaisen kerroksen jäähtyä."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ísklístur yfir grunnáburð. Láttu hvert lag kólna fyrir það næsta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is-klister: KX30 Blue eller KN33. Kan være vanskelige forhold."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isklister över grundvalla. Låt varje lager svalna före nästa."
          }
        }
      }
    },
    "WaxGuidance_MoistFineGrained" : {
      "comment" : "Wax guidance for moist fine-grained snow",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soft grip wax or fluorinated variant. Be prepared for changing conditions."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitovoidetta useina ohuina kerroksina. Pidennä pitoaluetta, jos luistaa."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harðáburður í nokkrum þunnum lögum. Lengdu festisvæðið ef það rennur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myk festevoks eller fluorert variant. Vær forberedt på endring i løpet av dagen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hårdvalla i flera tunna lager. Förläng fästzonen om den slirar."
          }
        }
      }
    },
    "WaxGuidance_MoistNewFallen" : {
      "comment" : "Wax guidance for moist new fallen snow",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use softer grip wax (V45-V60 / VP55-VP70). Apply multiple layers for better grip."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pehmeä pitovoide toimii parhaiten. Levitä ohuet kerrokset ja korkkaa hyvin."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mjúkur harðáburður virkar best. Berðu á þunn lög og korkaðu vel."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk mykere festevoks (V45-V60 / VP55-VP70). Påfør flere lag for bedre feste."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mjuk hårdvalla fungerar bäst. Lägg tunna lager och korka väl."
          }
        }
      }
    },
    "WaxGuidance_NewFallen" : {
      "comment" : "Wax guidance for new fallen snow (Group 1)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use hard grip wax matched to temperature. V-series for training, VP-series for racing."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä ilman lämpötilaan sopivaa pitovoidetta. Korkkaa se sileäksi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notaðu harðáburð sem passar við lofthita. Korkaðu hann sléttan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk hard festevoks tilpasset temperaturen. V-serie for trening, VP-serie for konkurranse."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd en hårdvalla anpassad till lufttemperaturen. Korka den slät."
          }
        }
      }
    },
    "WaxGuidance_OldGrained" : {
      "comment" : "Wax guidance for old grained snow (Group 3)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
