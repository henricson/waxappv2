    "Wax_Liquid_Notes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wipe on, let it dry, then polish. No iron required."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyhi päälle, anna kuivua ja kiillota. Silitysrautaa ei tarvita."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strjúktu á, láttu þorna og fægðu. Engin þörf á járni."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tørk på, la det tørke, og poler. Trenger ikke jern."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torka på, låt torka och polera. Inget strykjärn behövs."
          }
        }
      }
    },
    "Wax_Powder_Notes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Race-day topping. Apply over a hot-waxed and brushed base."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilpailupäivän pinnoite. Levitä voidellulle ja harjatulle pohjalle."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yfirlag á keppnisdegi. Berist á smurðan og burstaðan sóla."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topping til konkurransedagen. Legges over en smurt og børstet såle."
          }
