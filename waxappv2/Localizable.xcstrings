    "Wax_VP65_Notes" : {
      "comment" : "Notes for the Swix wax VP65.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Covers the awkward zero zone where hard wax and klister overlap."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kattaa hankalan nollavyöhykkeen, jossa pitovoide ja klisteri menevät päällekkäin."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nær yfir erfiða núllsvæðið þar sem harðáburður og klístur skarast."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dekker den vanskelige nullsonen der festevoks og klister overlapper."
          }
        },
        "sv" : {
