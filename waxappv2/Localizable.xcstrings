    "WaxGuidance_VeryWetCorn" : {
      "comment" : "Wax guidance for very wet corn snow",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm klister: KX65 or KX75. Use coarse structure on glide zones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Märkälumiklisteri. Pidä kerros ohuena, jottei se jarruta."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blautsnjóklístur. Hafðu lagið þunnt svo það bremsi ekki."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
