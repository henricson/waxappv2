      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro hard wax. Needs a clean, well-prepared kick zone to grip properly."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro-pitovoide. Vaatii puhtaan ja hyvin valmistellun pitoalueen."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro-harðáburður. Þarf hreint og vel undirbúið festisvæði."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro-festevoks. Krever en ren og godt preparert festesone for å feste."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro-hårdvalla. Kräver en ren och välpreparerad fästzon för att fästa."
          }
        }
      }
    },
